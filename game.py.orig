"""A simple gesture-controlled runner game for the Fontys gesture lab.

Controls:
    1 / 2 / 3 : easy / normal / hard difficulty
    + / -     : raise / lower confidence threshold
    R         : restart
    Q / Esc   : quit

Open hand = jump. The jump fires only once per stable open-hand gesture.
"""
import argparse
import time

import cv2
import mediapipe as mp
import numpy as np
import pygame

from gesture_lib import RuleClassifier

WIDTH, HEIGHT = 1180, 720
CAM_W, CAM_H = 480, 360
FPS_TARGET = 60

DIFFICULTY = {
    "easy": {
        "base_speed": 260.0,
        "spawn_min": 1.4,
        "spawn_max": 2.2,
        "stability": 1,
        "threshold": 0.50,
        "color": (120, 220, 120),
    },
    "normal": {
        "base_speed": 330.0,
        "spawn_min": 0.9,
        "spawn_max": 1.6,
        "stability": 2,
        "threshold": 0.60,
        "color": (255, 200, 90),
    },
    "hard": {
        "base_speed": 420.0,
        "spawn_min": 0.55,
        "spawn_max": 0.95,
        "stability": 3,
        "threshold": 0.70,
        "color": (255, 110, 110),
    },
}


def parse_args():
    parser = argparse.ArgumentParser(description="Gesture-controlled runner")
    parser.add_argument(
        "--camera",
        type=int,
        default=0,
        help="Camera index (0 on most Macs/Windows, sometimes 1)",
    )
    parser.add_argument(
        "--difficulty",
        choices=list(DIFFICULTY),
        default="normal",
        help="Game difficulty",
    )
    return parser.parse_args()


def to_pygame_surface(bgr_frame):
    """Convert an OpenCV BGR frame to a Pygame RGB surface."""
    rgb = cv2.cvtColor(bgr_frame, cv2.COLOR_BGR2RGB)
    return pygame.image.frombuffer(rgb.tobytes(), rgb.shape[1::-1], "RGB")


def main():
    args = parse_args()

    pygame.init()
    pygame.display.set_caption("Fontys Gesture Lab | Open hand = jump")
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    clock = pygame.time.Clock()
    font = pygame.font.SysFont("consolas", 20)
    small = pygame.font.SysFont("consolas", 16)

    cap = cv2.VideoCapture(args.camera)
    if not cap.isOpened():
        pygame.quit()
        raise RuntimeError(
            f"Could not open camera at index {args.camera}. "
            "Try another index with --camera N."
        )

    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    mp_hands = mp.solutions.hands
    mp_draw = mp.solutions.drawing_utils
    hands = mp_hands.Hands(
        static_image_mode=False,
        max_num_hands=1,
        model_complexity=0,
        min_detection_confidence=0.5,
        min_tracking_confidence=0.5,
    )

    classifier = RuleClassifier()
    difficulty_name = args.difficulty
    settings = DIFFICULTY[difficulty_name].copy()
    threshold = settings["threshold"]

    detected = "none"
    score = 0.0
    stable_count = 0
    jump_latched = False
    camera_surface = None

    # Game state
    ground_y = 590
    player_x = 620
    player_w, player_h = 42, 56
    player_y = ground_y - player_h
    velocity_y = 0.0
    gravity = 1800.0
    jump_velocity = -690.0
    obstacles = []
    spawn_timer = 0.8
    score_points = 0.0
    game_over = False
    running = True

    def set_difficulty(name):
        nonlocal difficulty_name, settings, spawn_timer, threshold
        difficulty_name = name
        settings = DIFFICULTY[name].copy()
        spawn_timer = settings["spawn_min"]
        threshold = settings["threshold"]

    def reset_game():
        nonlocal player_y, velocity_y, obstacles, spawn_timer, score_points, game_over, jump_latched, stable_count
        player_y = ground_y - player_h
        velocity_y = 0.0
        obstacles = []
        spawn_timer = settings["spawn_min"]
        score_points = 0.0
        game_over = False
        jump_latched = False
        stable_count = 0

    def draw_text(text, x, y, color=(235, 240, 245), use_small=False):
        surf = (small if use_small else font).render(text, True, color)
        screen.blit(surf, (x, y))

    set_difficulty(difficulty_name)

    while running:
        loop_start = time.perf_counter()
        dt = min(clock.tick(FPS_TARGET) / 1000.0, 0.05)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key in (pygame.K_q, pygame.K_ESCAPE):
                    running = False
                elif event.key == pygame.K_r:
                    reset_game()
                elif event.key == pygame.K_1:
                    set_difficulty("easy")
                elif event.key == pygame.K_2:
                    set_difficulty("normal")
                elif event.key == pygame.K_3:
                    set_difficulty("hard")
                elif event.key in (pygame.K_EQUALS, pygame.K_PLUS, pygame.K_KP_PLUS):
                    threshold = min(0.95, threshold + 0.05)
                elif event.key in (pygame.K_MINUS, pygame.K_KP_MINUS):
                    threshold = max(0.10, threshold - 0.05)

        ok, frame = cap.read()
        if ok:
            frame = cv2.flip(frame, 1)
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            result = hands.process(rgb)

            if result.multi_hand_landmarks:
                landmarks = result.multi_hand_landmarks[0]
                detected, score = classifier.classify(landmarks)
                mp_draw.draw_landmarks(
                    frame,
                    landmarks,
                    mp_hands.HAND_CONNECTIONS,
                    mp_draw.DrawingSpec(color=(0, 255, 0), thickness=2, circle_radius=2),
                    mp_draw.DrawingSpec(color=(0, 200, 255), thickness=2),
                )
            else:
                detected = "none"
                score = 0.0

            camera_surface = to_pygame_surface(
                cv2.resize(frame, (CAM_W, CAM_H), interpolation=cv2.INTER_LINEAR)
            )

        open_event = False
        if detected == "open" and score >= threshold:
            stable_count += 1
            if stable_count >= settings["stability"] and not jump_latched:
                open_event = True
        else:
            stable_count = 0
            jump_latched = False

        if open_event and not game_over:
            if player_y >= ground_y - player_h - 1:
                velocity_y = jump_velocity
            jump_latched = True

        if not game_over:
            velocity_y += gravity * dt
            player_y += velocity_y * dt
            if player_y > ground_y - player_h:
                player_y = ground_y - player_h
                velocity_y = 0.0

            spawn_timer -= dt
            if spawn_timer <= 0:
                obstacle_h = int(np.random.randint(35, 72))
                obstacles.append(
                    pygame.Rect(WIDTH + 10, ground_y - obstacle_h, 24, obstacle_h)
                )
                spawn_timer = float(
                    np.random.uniform(settings["spawn_min"], settings["spawn_max"])
                )

            for obstacle in obstacles:
                obstacle.x -= int(settings["base_speed"] * dt)
            obstacles = [ob for ob in obstacles if ob.right > 0]

            player_rect = pygame.Rect(int(player_x), int(player_y), player_w, player_h)
            if any(player_rect.colliderect(ob) for ob in obstacles):
                game_over = True

            score_points += dt * 10.0
            settings["base_speed"] = min(
                520.0,
                DIFFICULTY[difficulty_name]["base_speed"] + score_points * 0.7,
            )

        loop_ms = (time.perf_counter() - loop_start) * 1000.0
        fps = clock.get_fps()

        screen.fill((18, 23, 33))
        pygame.draw.rect(screen, (28, 36, 49), (0, 0, WIDTH, 385))

        if camera_surface is not None:
            screen.blit(camera_surface, (24, 24))
        else:
            pygame.draw.rect(screen, (35, 42, 55), (24, 24, CAM_W, CAM_H))
            draw_text("Camera preview unavailable", 40, 45)

        pygame.draw.rect(screen, (75, 91, 112), (20, 20, CAM_W + 8, CAM_H + 8), 2)

        diff_color = settings["color"]
        pygame.draw.rect(screen, diff_color, (525, 28, 14, 14), border_radius=3)
        draw_text(f"Difficulty: {difficulty_name.upper()}", 548, 25)
        draw_text(f"Gesture: {detected} ({score:.2f})", 525, 58)
        draw_text(f"Threshold: {threshold:.2f}  (+ / -)", 525, 91)
        draw_text(f"Speed: {settings['base_speed']:.0f}", 525, 124)
        draw_text(f"FPS: {fps:.1f}  |  Loop: {loop_ms:.1f} ms", 525, 157)
        draw_text(
            "Controls: 1 easy  2 normal  3 hard  +/- threshold  R restart  Q quit",
            525,
            190,
            use_small=True,
        )

        pygame.draw.rect(screen, (13, 17, 24), (0, 390, WIDTH, HEIGHT - 390))
        pygame.draw.line(screen, (110, 125, 145), (0, ground_y), (WIDTH, ground_y), 3)
        pygame.draw.rect(
            screen,
            (88, 197, 255),
            (int(player_x), int(player_y), player_w, player_h),
            border_radius=7,
        )
        for obstacle in obstacles:
            pygame.draw.rect(screen, (255, 111, 105), obstacle, border_radius=5)
        draw_text(f"Score: {int(score_points)}", 24, 410)
        draw_text("Open hand = jump. Close hand to re-arm.", 24, 445, use_small=True)

        if game_over:
            overlay = pygame.Surface((WIDTH, 130), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 180))
            screen.blit(overlay, (0, 480))
            draw_text("GAME OVER", 500, 510)
            draw_text("Press R to restart", 490, 545)

        pygame.display.flip()

    hands.close()
    cap.release()
    pygame.quit()


if __name__ == "__main__":
    main()
